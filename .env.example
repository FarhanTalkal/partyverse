# Frontend (apps/web) — copy to apps/web/.env.local
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000

# Server (apps/server) — copy to apps/server/.env
PORT=4000
CORS_ORIGIN=http://localhost:3000
NODE_ENV=development

# Optional AI (OpenAI-compatible). Leave blank to use curated content only.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=12000
AI_ENABLED=false

# Room / security tuning
ROOM_IDLE_TTL_MS=1800000
CHAT_RATE_LIMIT_PER_MIN=20
